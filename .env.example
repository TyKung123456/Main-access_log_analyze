# ตัวอย่างไฟล์ .env (dev) — ปรับค่าให้ตรงเครื่อง

# --- Server / Backend ---
NODE_ENV=development
PORT=3001
# ใช้สำหรับตั้ง CORS ให้ตรงกับ Frontend
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
# โค้ดตั้งค่าดีฟอลต์ PORT=5433 (ถ้าเครื่องคุณใช้ 5432 ให้แก้ค่านี้)
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5433
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=admin
DB_POSTGRESDB_PASSWORD=P@ssw0rd
DB_SSL=false

# --- Security / Mock ---
# true = อนุญาตให้คืนข้อมูล mock กรณี query เคสได้ 0 แถว
ENABLE_SECURITY_CASES_MOCK=false

# --- AI (Backend: Ollama) ---
# ใช้เฉพาะเมื่อเชื่อมต่อ AI แบบ local ผ่าน backend `/api/ai/chat`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=60000

# --- Frontend (Vite) ---
# แนะนำตั้งเป็นโคน URL ของ backend ไม่ต้องต่อท้าย /api
VITE_API_BASE_URL=http://localhost:3001

# โหมด AI ฝั่ง FE: mock (ง่ายสุด), local (Ollama), mcp (ถ้าเชื่อม MCP)
VITE_AI_PROVIDER=mock
VITE_DEBUG_AI=false

# Ollama (เมื่อใช้ VITE_AI_PROVIDER=local)
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2:3b
VITE_OLLAMA_TIMEOUT=60000
VITE_OLLAMA_MAX_RETRIES=3

# คุณสมบัติ/สวิตช์ฟีเจอร์
VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_LOG_ANALYSIS=true
VITE_ENABLE_DEMO_MODE=false
VITE_ENABLE_SAMPLE_DATA=true
VITE_ENABLE_AI_EXPORT_SUMMARY=true
VITE_FORCE_CASES_MOCK=false
VITE_CASES_FROM_DATA=false

# Branding (แสดงโลโก้บน Header ถ้าตั้งค่า)
VITE_BRAND_LOGO_URL=
VITE_BRAND_NAME=
VITE_BRAND_LINK=
VITE_BRAND_LOGO_HEIGHT=48

# หมายเหตุ:
# - โปรเจกต์นี้ใช้ Vite จึงอ่านเฉพาะตัวแปรที่ขึ้นต้นด้วย VITE_
# - ฝั่ง backend ใช้ตัวแปร process.env ตามที่กำหนดด้านบน
# - อย่าใส่ /api ต่อท้าย VITE_API_BASE_URL เพื่อหลีกเลี่ยงการซ้ำ /api/api ในบาง service

