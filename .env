# ===============================================
# ACCESS LOG ANALYZER - OLLAMA CONFIGURATION
# ===============================================

# ===============================================
# 🚀 FRONTEND CONFIGURATION
# ===============================================
VITE_API_BASE_URL=http://localhost:3001
VITE_ENABLE_SAMPLE_DATA=false
VITE_MAX_LOG_FILE_SIZE=52428800

# ===============================================
# 🤖 AI CONFIGURATION - OLLAMA LOCAL MODEL
# ===============================================
VITE_AI_PROVIDER=local
VITE_ENABLE_AI_CHAT=true
VITE_DEBUG_AI=true

# Ollama Configuration
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3:latest
VITE_OLLAMA_TIMEOUT=60000
VITE_OLLAMA_MAX_RETRIES=3

# Alternative Thai models (uncomment to use):
# VITE_OLLAMA_MODEL=llama3.2:1b
# VITE_OLLAMA_MODEL=llama3:8b
# VITE_OLLAMA_MODEL=gemma2:2b
# VITE_OLLAMA_MODEL=phi3:mini
# VITE_OLLAMA_MODEL=qwen2.5:3b

# Backend Ollama Configuration (same as frontend)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT=60000
OLLAMA_MAX_RETRIES=3

# ===============================================
# 🗄️ DATABASE CONFIGURATION (Real PostgreSQL)
# ===============================================
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5433
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=admin
DB_POSTGRESDB_PASSWORD=P@ssw0rd

# ===============================================
# 🖥️ BACKEND SERVER CONFIGURATION
# ===============================================
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5174

# ===============================================
# 📁 FILE UPLOAD SETTINGS
# ===============================================
LOG_UPLOAD_DIR=uploads/logs
MAX_LOG_FILE_SIZE=52428800
ALLOWED_LOG_FILE_TYPES=txt,log,csv

# ===============================================
# 🎨 UI/UX SETTINGS
# ===============================================
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100
VITE_CHART_ANIMATION=true
VITE_AUTO_REFRESH_INTERVAL=30000

# Feature Flags
VITE_ENABLE_DEMO_MODE=false
VITE_ENABLE_EXPORT=true
VITE_ENABLE_FILTERS=true

# ===============================================
# 🔧 DEVELOPMENT SETTINGS
# ===============================================
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
DEV_ENABLE_MOCK_DATA=false

# ===============================================
# 📋 NOTES FOR OLLAMA SETUP
# ===============================================
# 
# 🤖 การติดตั้ง Ollama:
# 1. ดาวน์โหลดจาก: https://ollama.ai
# 2. รันคำสั่ง: ollama serve
# 3. ติดตั้งโมเดล: ollama pull llama3.2:3b
# 
# 🎯 โมเดลที่แนะนำสำหรับภาษาไทย:
# • llama3.2:3b - ดีมาก รองรับไทยได้ดี (3GB)
# • llama3.2:1b - เร็ว เหมาะกับเครื่องช้า (1GB)
# • gemma2:2b - เร็วมาก รองรับไทยพอใช้ (2GB)
# • qwen2.5:3b - ดีเยี่ยม รองรับไทยดี (3GB)
# 
# 🚀 คำสั่งติดตั้งโมเดล:
# ollama pull llama3.2:3b
# ollama pull llama3.2:1b
# ollama pull gemma2:2b
# ollama pull qwen2.5:3b
# 
# 🔍 ตรวจสอบโมเดลที่ติดตั้ง:
# ollama list
# 
# 💻 ตรวจสอบสถานะ Ollama:
# curl http://localhost:11434/api/tags
# 
# ===============================================
